{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug"
    }
  },
  "AllowedHosts": "*",
  "VmSettings": {
    "BaseImageDir": "/var/lib/libvirt/images/base",
    "InstanceDir": "/var/lib/libvirt/images/instances",
    "DefaultNetwork": "default",
    "MaxInstancesPerUser": "5"
  },
  "RuleSets": [
    {
      "Id": "suricata",
      "Name": "Suricata",
      "Description": "Suricata IDS/IPS detection rules",
      "Directory": "/var/lib/suricata/rules",
      "AllowedExtensions": [".rules"],
      "MaxFileSizeBytes": 5242880,
      "Restart": {
        "VmName": "malcolm",
        "Path": "/usr/bin/docker",
        "Args": ["compose", "-f", "/opt/Malcolm/docker-compose.yml", "restart", "suricata-live"],
        "TimeoutSeconds": 90,
        "Description": "Restart Suricata container in the Malcolm VM via docker compose"
      }
    },
    {
      "Id": "yara",
      "Name": "YARA",
      "Description": "YARA malware identification rules",
      "Directory": "/var/lib/yara/rules",
      "AllowedExtensions": [".yar", ".yara"],
      "MaxFileSizeBytes": 1048576
    },
    {
      "Id": "zeek",
      "Name": "Zeek",
      "Description": "Zeek network analysis scripts",
      "Directory": "/opt/zeek/share/zeek/site",
      "AllowedExtensions": [".zeek"],
      "MaxFileSizeBytes": 1048576,
      "Restart": {
        "VmName": "malcolm",
        "Path": "/usr/bin/docker",
        "Args": ["compose", "-f", "/opt/Malcolm/docker-compose.yml", "restart", "zeek-live"],
        "TimeoutSeconds": 90,
        "Description": "Restart Zeek container in the Malcolm VM via docker compose"
      }
    }
  ],
  "VmTemplates": [
    {
      "Id": "kali-2024",
      "Name": "Kali Linux 2024",
      "Description": "Penetration testing and security auditing OS",
      "BaseImage": "kali-2024.qcow2",
      "Category": "offensive",
      "Specs": { "Memory": 4096, "Cpus": 2, "DiskSize": 40 },
      "Tags": ["pentest", "kali", "offensive"]
    },
    {
      "Id": "win10-target",
      "Name": "Windows 10 Target",
      "Description": "Windows 10 target machine for testing",
      "BaseImage": "win10-target.qcow2",
      "Category": "targets",
      "Specs": { "Memory": 4096, "Cpus": 2, "DiskSize": 60 },
      "Tags": ["windows", "target", "vulnerable"]
    }
  ]
}
